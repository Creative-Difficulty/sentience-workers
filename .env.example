POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentience

RUSTFS_ACCESS_KEY=devadmin
RUSTFS_SECRET_KEY=devadmin
S3_BUCKET_NAME=sentience

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

DISCORD_TOKEN=
GUILD_ID=
DISCORD_SERVER_NAME=

# Optional
# RUST_LOG=info
# unidb-schema commit baked into the postgres image; keep equal to the unidb rev in Cargo.lock
# UNIDB_REF=a7a7c55458aef4f1bef899c4527af3559a925033
# Build schema + `unidb` crate from a local unidb-schema checkout (with .git) instead of GitHub
# UNIDB_CONTEXT=../unidb-schema
# Host bindings (default: loopback only)
# POSTGRES_PUBLISH=127.0.0.1:5432
# RUSTFS_CONSOLE_PUBLISH=127.0.0.1:9001
# DASH_PUBLISH=127.0.0.1:3000
# Dashboard build context (git URL or local checkout)
# DASH_CONTEXT=../Sentience-dash
