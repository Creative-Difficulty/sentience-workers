DATABASE_URL=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

DISCORD_SERVER_NAME=

# Optional (defaults shown)
# LLM_TIMEOUT_SECS=120        # per HTTP request to the LLM
# MAX_ATTEMPTS=3              # failures before a message is skipped for good
# RETRY_BASE_DELAY_SECS=30    # cool-down after a failure, doubles per failure (max 15 min)
# BATCH_SIZE=25               # messages per polling round
# READY_FILE=/tmp/ready       # written once config is valid and the DB is reachable
# RUST_LOG=fact_extractor=debug
