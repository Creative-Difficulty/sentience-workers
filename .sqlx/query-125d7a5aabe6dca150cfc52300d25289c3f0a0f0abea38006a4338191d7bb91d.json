{
  "db_name": "PostgreSQL",
  "query": "SELECT m.* FROM messages m\n           WHERE NOT EXISTS (\n               SELECT 1 FROM fact_extraction_attempts fea\n               WHERE fea.message_id = m.message_id\n           )\n             AND m.deleted_at IS NULL\n             AND m.content != '[deleted message]'\n             AND char_length(m.content) >= $1\n           ORDER BY m.sent_at\n           LIMIT $2",
