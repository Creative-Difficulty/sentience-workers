{
  "db_name": "PostgreSQL",
  "query": "SELECT m.* FROM messages m\n               WHERE NOT EXISTS (\n                   SELECT 1 FROM message_classification_attempts mca\n                   WHERE mca.message_id = m.message_id\n               )\n                 AND m.content != '[deleted message]'\n               ORDER BY m.channel_id, m.sent_at\n               LIMIT $1",
