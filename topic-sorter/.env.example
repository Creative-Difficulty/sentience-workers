DATABASE_URL=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional (defaults shown)
# LLM_TIMEOUT_SECS=120        # per HTTP request to the LLM
# MAX_ATTEMPTS=3              # failures before a batch's messages are skipped for good
# RETRY_BASE_DELAY_SECS=30    # cool-down after a failure, doubles per failure (max 15 min)
# BATCH_SIZE=50               # messages per polling round
# MAX_PROMPT_TOPICS=200       # existing topic names (most recently used) offered for reuse
# READY_FILE=/tmp/ready       # written once config is valid and the DB is reachable
# RUST_LOG=topic_sorter=debug
